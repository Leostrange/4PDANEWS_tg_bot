# ╔══════════════════════════════════════════════════════╗
# ║  Конфигурация Telegram-бота «НовостИИ»              ║
# ║  Скопируй в .env и заполни своими данными           ║
# ╚══════════════════════════════════════════════════════╝

# ── Telegram Bot Token ──
# Получи у @BotFather в Telegram: /newbot
BOT_TOKEN=your_bot_token_here

# ── AI-провайдер ──
# Любой OpenAI-совместимый API (OpenAI, OpenRouter, Together, Groq, LM Studio и др.)

# Базовый URL (без /chat/completions — он добавится автоматически)
API_BASE_URL=https://api.openai.com/v1

# API-ключ провайдера
API_KEY=your_api_key_here

# Модель для генерации
MODEL=gpt-4o

# Максимальное количество токенов в ответе
MAX_TOKENS=16384

# Температура (0.0 = точно, 1.0 = креативно)
TEMPERATURE=0.3

# ── Лимиты ──
MAX_POSTS=100
MAX_CHARS=500000

# ── Промпт ──
SYSTEM_PROMPT_FILE=system_prompt.md


# ╔══════════════════════════════════════════════════════╗
# ║  ПРИМЕРЫ ДЛЯ РАЗНЫХ ПРОВАЙДЕРОВ                     ║
# ╚══════════════════════════════════════════════════════╝

# ── OpenAI ──
# API_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o

# ── OpenRouter ──
# API_BASE_URL=https://openrouter.ai/api/v1
# MODEL=anthropic/claude-sonnet-4

# ── Together AI ──
# API_BASE_URL=https://api.together.xyz/v1
# MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# ── Groq ──
# API_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile

# ── Anthropic (через прокси, например https://api.openai-proxy.org) ──
# API_BASE_URL=https://api.anthropic.com/v1
# MODEL=claude-sonnet-4-20250514

# ── LM Studio (локально) ──
# API_BASE_URL=http://localhost:1234/v1
# MODEL=local-model

# ── Ollama (через OpenAI-совместимый режим) ──
# API_BASE_URL=http://localhost:11434/v1
# MODEL=llama3.1
