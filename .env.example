# ╔══════════════════════════════════════════════════════╗
# ║  Конфигурация Telegram-бота «НовостИИ»              ║
# ║  Скопируй в .env и заполни своими данными           ║
# ╚══════════════════════════════════════════════════════╝

# ── Telegram Bot Token ──
# Получи у @BotFather в Telegram: /newbot
BOT_TOKEN=your_bot_token_here
# Telegram user ID владельца. Пустое значение разрешает доступ всем и расходует ваш AI-бюджет.
ALLOWED_USER_IDS=

# AI-провайдер и ключ задаются в личном диалоге с ботом командой /provider.

# Максимальное количество токенов в ответе
MAX_TOKENS=16384

# Температура (0.0 = точно, 1.0 = креативно)
TEMPERATURE=0.3

# ── Лимиты ──
MAX_POSTS=100
MAX_CHARS=60000
DATA_FILE=data/sessions.json

# ── Промпт ──
SYSTEM_PROMPT_FILE=system_prompt.md
